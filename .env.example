# =========================================================
# Supabase
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Connection string para `supabase db push`, seeds y scripts.
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# =========================================================
# App
# =========================================================
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota

# =========================================================
# IA (opcionales en dev — sin claves los endpoints caen en modo mock)
# =========================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Si true y no hay claves, los endpoints IA devuelven respuestas mock deterministas.
AI_MOCK_MODE=true

# =========================================================
# Notificaciones (opcionales en dev)
# =========================================================
RESEND_API_KEY=
RESEND_FROM="PQRS Energía <noreply@pqrs.local>"

# WhatsApp Cloud API (Meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Aliases legacy aceptados por el código:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# =========================================================
# Power BI / API tokens internos
# =========================================================
POWERBI_API_SECRET=
POWERBI_API_TOKEN=

# =========================================================
# Cron jobs (Vercel Cron / pg_cron) — define el header Bearer
# =========================================================
CRON_SECRET=change-me-in-prod-please
